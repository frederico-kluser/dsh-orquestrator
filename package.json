{
  "name": "dsh-orquestrator",
  "version": "0.8.3",
  "description": "DeepSeek Harness plugin: a native-looking modal on task send lets you pick the model subagents run on. The pick, a reasoning-effort ceiling and an output-token cap are enforced in code on every child DSH starts, whichever tool starts it: the subagent tools, a workflow, ralph or a one-shot background job. It also ships a global agent skill that teaches the main agent to split work, run subagents in parallel and verify them (a checkbox in the modal applies it to a message), and shows the model and state of each subagent in the task page's subagent list.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.cjs",
    "skills/orchestrate-subagents/SKILL.md",
    "cordis.patch.yml",
    "README.md",
    "README.pt-BR.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "playwright-core": "1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "gen:skill": "node scripts/gen-skill.mjs",
    "prepare": "husky",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm run gen:skill && pnpm run typecheck && tsdown --config tsdown.config.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "pnpm run build && pnpm run test && node scripts/check-lib.mjs",
    "check:lib": "node scripts/check-lib.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frederico-kluser/dsh-orquestrator.git"
  },
  "bugs": {
    "url": "https://github.com/frederico-kluser/dsh-orquestrator/issues"
  },
  "homepage": "https://github.com/frederico-kluser/dsh-orquestrator#readme",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "cordis",
    "deepseek-harness",
    "subagents",
    "workflow",
    "reasoning-effort",
    "orchestration",
    "multi-model",
    "agent-skill"
  ]
}
